  "layers": [
    {
      "id": "L1",
      "band": "interface",
      "name": {
        "zh": "减负",
        "en": "Cognitive Load Reduction"
      },
      "definition": {
        "zh": "把认知负荷从信息量转移到结构",
        "en": "Shift cognitive load from information volume to structure"
      },
      "anchor": {
        "zh": "第1章 1.1;工具 A.1",
        "en": "Ch.1 §1.1; Tool A.1"
      },
      "evidence": "E1(机制 E3)",
      "falsifier": {
        "zh": "若结构化压缩后,读者的理解准确率与错误发现率不优于原文,则 L1 在该任务上失败。",
        "en": "If comprehension accuracy and error-detection after structured compression are no better than with the original text, L1 fails on that task."
      }
    },
    {
      "id": "L2",
      "band": "interface",
      "name": {
        "zh": "可体验",
        "en": "Experiential Rendering"
      },
      "definition": {
        "zh": "把「读到」变成「操作到」",
        "en": "Turn \"read\" into \"operated\""
      },
      "anchor": {
        "zh": "第3章;第9章 M1",
        "en": "Ch.3; Ch.9 M1"
      },
      "evidence": "E1(机制 E3)",
      "falsifier": {
        "zh": "若可操作版本相对静态版本在迁移任务上没有增益,则 L2 失败。",
        "en": "If the operable version yields no gain over the static version on transfer tasks, L2 fails."
      }
    },
    {
      "id": "L3",
      "band": "processing",
      "name": {
        "zh": "意义生成",
        "en": "Meaning Generation"
      },
      "definition": {
        "zh": "组织成方向·价值·边界",
        "en": "Organise into direction · value · boundary"
      },
      "anchor": {
        "zh": "第3章 3.1 / 3.2;第8章 8.1 光谱带",
        "en": "Ch.3 §3.1/3.2; Ch.8 §8.1 spectrum band"
      },
      "evidence": "E0–E1",
      "falsifier": {
        "zh": "若独立标注者无法把同一材料稳定归入方向、价值、边界(一致性低于预设阈值),则 L3 失败。",
        "en": "If independent raters cannot sort the same material into direction/value/boundary consistently (agreement below a preset threshold), L3 fails."
      }
    },
    {
      "id": "L4",
      "band": "processing",
      "name": {
        "zh": "价值评估",
        "en": "Value Assessment"
      },
      "definition": {
        "zh": "为判断标注证据强度",
        "en": "Label every judgement with its strength of evidence"
      },
      "anchor": {
        "zh": "第6章 E0–E6;3.3 PE 方程",
        "en": "Ch.6 E0–E6; §3.3 PE equation"
      },
      "evidence": "E2(工具)/ E1(模型)",
      "falsifier": {
        "zh": "若证据等级标注在评审者之间不一致,或与后续检验结果无单调关系,则 L4 失败。",
        "en": "If evidence grades disagree across reviewers, or bear no monotone relation to later test outcomes, L4 fails."
      }
    },
    {
      "id": "L5",
      "band": "meta",
      "name": {
        "zh": "方向选择",
        "en": "Direction Selection"
      },
      "definition": {
        "zh": "在五尺度上选定值得的方向",
        "en": "Choose the worthwhile direction across five scales"
      },
      "anchor": {
        "zh": "第4章;DC 指标;三级修正",
        "en": "Ch.4; DC index; three-level correction"
      },
      "evidence": "E1",
      "falsifier": {
        "zh": "若按该层选出的方向在事后评估中不优于基线或随机选择,则 L5 失败。",
        "en": "If directions chosen by this layer do no better than a baseline or random choice in post-hoc evaluation, L5 fails."
      }
    },
    {
      "id": "L6",
      "band": "meta",
      "name": {
        "zh": "反思与审视递归",
        "en": "Recursive Reflection and Review"
      },
      "definition": {
        "zh": "让系统审视自己的审视",
        "en": "Let the system review its own reviewing"
      },
      "anchor": {
        "zh": "第7章 7B.2/7B.3/7B.4;失败矩阵",
        "en": "Ch.7 §7B.2/7B.3/7B.4; failure matrix"
      },
      "evidence": "E2(案例)/ E1",
      "falsifier": {
        "zh": "若递归审视在后续轮次中没有比无审视对照更高的纠错率,则 L6 失败。",
        "en": "If recursive review does not correct earlier errors at a higher rate than a no-review control in later rounds, L6 fails."
      }
    }
  ],
